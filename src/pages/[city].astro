---
import Base from '../layouts/Base.astro';
import QuickForm from '../components/QuickForm.astro';
import HeroSlides from '../components/HeroSlides.astro';
import { site, wa, waMsg, cities, faq, steps, reviews, reviewsSummary } from '../data/site';

export function getStaticPaths() {
  return cities.filter((c) => c.enabled).map((c) => ({ params: { city: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: any };
const msg = c.name === 'חריש' ? waMsg.harish : `היי ברוך, אני מ${c.name} ואשמח לפרטים על שיעורי נהיגה`;
---
<Base
  title={`${c.title} • אוטומט עם איסוף מהבית • ${site.name}`}
  description={`${c.title}: ${site.name}, מורה נהיגה עצמאי על אוטומט. איסוף מהבית ב${c.name}, ${site.price} ₪ לשיעור של ${site.lessonMinutes} דקות, הטסט ב${site.testCity}. ${site.phoneDisplay}`}
  city={c.name}
  waText={msg}
>
  <section class="hero hero-city">
    <HeroSlides />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="hero-kicker">{c.kicker ?? `לומדים ב${c.name}, נבחנים ב${site.testCity}`}</p>
      <h1 class="hero-title">{c.h1}</h1>
      <p class="hero-sub">{c.lead}</p>
      <QuickForm dark />
    </div>
  </section>

  <section class="intro">
    <div class="container narrow">
      <h2 class="sec-title">שיעורי נהיגה ב{c.name}, טסט ב{site.testCity}</h2>
      {c.body.map((p: string) => <p>{p}</p>)}
      <ul class="feature-list">
        <li>איסוף מהבית ב{c.name}</li>
        <li>{site.car}</li>
        <li>{site.price} ₪ לשיעור של {site.lessonMinutes} דקות</li>
        <li>מינימום {site.minLessonsByLaw} שיעורי חובה לפי החוק</li>
        <li>תרגול מסלולים לקראת הטסט ב{site.testCity}</li>
      </ul>
      <p><a class="promo" href={wa(msg)} target="_blank" rel="noopener"><b>גרים ב{c.name}?</b> שלחו הודעה בוואטסאפ</a></p>
    </div>
  </section>

  <section class="steps">
    <div class="container">
      <h2 class="sec-title">הדרך לרישיון, בחמישה שלבים</h2>
      <ol class="step-list">
        {steps.map((s, i) => <li><span class="step-n">{i + 1}</span><b>{s.title}</b><p>{s.text}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="reviews">
    <div class="container">
      <h2 class="sec-title">המלצות של תלמידים על ברוך</h2>
      <p class="review-summary"><b>{reviewsSummary.easyScore}</b> ציון ב-easy מתוך {reviewsSummary.easyCount} ביקורות · ★★★★★ בגוגל</p>
      <div class="review-row">
        {reviews.slice(0, 6).map((r) => (
          <figure class="review-card">
            {r.source === 'google' && <span class="review-stars" aria-label="5 כוכבים">★★★★★</span>}
            <blockquote>{r.text}</blockquote>
            <figcaption><b dir="auto">{r.name}</b><small>{r.source === 'google' ? 'ביקורת בגוגל' : 'ביקורת ב-easy'}{r.date && ` · ${r.date}`}</small></figcaption>
          </figure>
        ))}
      </div>
      <p class="review-more"><a class="strong-link" href={reviewsSummary.easyUrl} target="_blank" rel="noopener">לכל {reviewsSummary.easyCount} הביקורות ב-easy &gt;&gt;</a></p>
    </div>
  </section>

  <section class="passed">
    <div class="container">
      <h2 class="sec-title">מזל טוב לתלמידים שעברו טסט!</h2>
      <div class="passed-grid">
        {[1,2,3,4,5,6,7].map((n) => <img src={`/images/students/pass-${n}.jpg`} alt="תלמיד של ברוך תור אחרי שעבר טסט, עם שלט נהג חדש" width="750" height="1000" loading="lazy" />)}
        <img src="/images/students/baruch-student.jpg" alt="ברוך תור עם תלמיד שעבר טסט" width="1000" height="750" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="faq-sec">
    <div class="container narrow">
      <h2 class="sec-title">שאלות ותשובות</h2>
      {faq.map((f: any) => <details><summary>{f.q}</summary>{f.html ? <p set:html={f.html} /> : <p>{f.a}</p>}</details>)}
    </div>
  </section>

  <section class="contact-band">
    <div class="container contact-inner">
      <div><h2>מתחילים ללמוד ב{c.name}</h2><p>השאירו שם ונייד ואחזור אליכם.</p></div>
      <QuickForm />
    </div>
  </section>
</Base>
